# -----------------------------------------------------------------------------
# Finance Approval Web App - Microsoft/Vercel environment template
# -----------------------------------------------------------------------------
# Do not commit real secrets. Copy these values into Vercel Project Settings
# and/or the backend host secret manager.

# Public frontend settings
VITE_APP_URL=https://your-vercel-project.vercel.app
VITE_API_URL=https://your-existing-backend.example.com
VITE_AUTH_PROVIDER=entra
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_REDIRECT_URI=https://your-vercel-project.vercel.app/auth/callback
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=https://your-vercel-project.vercel.app/login

# Backend database
DATABASE_URL=mysql://user:password@host:3306/database

# Microsoft Entra token validation
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000
ENTRA_ALLOWED_DOMAINS=compawnion.co,pawmeals.co,cattocatfood.com

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER_TEMPLATES=finance-templates
AZURE_STORAGE_CONTAINER_SUBMISSIONS=finance-submissions
AZURE_STORAGE_CONTAINER_ATTACHMENTS=finance-attachments
AZURE_STORAGE_SAS_EXPIRY_MINUTES=15

# Microsoft Graph notifications
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=replace-in-secret-manager
GRAPH_SENDER_MAILBOX=finance-system@compawnion.co
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_WEBHOOK_URL=

# Application bootstrap
INITIAL_ADMIN_EMAIL=eddie.amintohir@compawnion.co
SYSTEM_EMAIL=finance-system@compawnion.co
APP_BASE_URL=https://your-vercel-project.vercel.app
NODE_ENV=production
