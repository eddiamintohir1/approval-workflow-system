VITE_ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
VITE_API_URL=
VITE_APP_URL=http://localhost:3000

# Primary database
DATABASE_URL=

# Azure Blob Storage (server-only secret)
AZURE_STORAGE_CONNECTION_STRING=
